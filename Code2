function updateTimeLabels(){

    const now=
        new Date();

    const currentHour=
        now.getHours();

    const currentMinutes=
        now.getMinutes();

    function formatTime(
        totalMinutes
    ){

        totalMinutes=
            (
                totalMinutes+
                1440
            )%1440;

        const h=
            Math.floor(
                totalMinutes/60
            );

        const m=
            totalMinutes%60;

        return(
            String(h)
            .padStart(2,"0")
            +":"
            +
            String(m)
            .padStart(2,"0")
        );
    }


    const currentTotal=
        currentHour*60+
        currentMinutes;


    document
    .getElementById("t1")
    .innerText=
        formatTime(
            currentTotal-60
        );

    document
    .getElementById("t2")
    .innerText=
        formatTime(
            currentTotal-50
