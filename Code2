/* ==================================================
HEARTBEAT WAVE
================================================== */

let selectedTrend="Power";

let waveOffset=0;


/* ECG SHAPE */

function createHeartbeatPath(){

    const width=900;
    const height=340;

    const baseline=185;

    let path=
        "M 0 "+
        baseline;

    /*
       Repeating ECG-style pattern:
       small rise
       sharp rise
       deep drop
       tall spike
       return
    */

    const cycle=120;

    for(
        let x=0;
        x<=width+cycle;
        x+=cycle
    ){

        const base=x-waveOffset;

        /* P wave */

        path+=
            " C "+
            (base+10)+" "+
            (baseline-5)+
            ", "+
            (base+18)+" "+
            (baseline-12)+
            ", "+
            (base+28)+" "+
            baseline;


        /* Q */

        path+=
            " L "+
            (base+42)+" "+
            (baseline+8);


        /* R spike */

        path+=
            " L "+
            (base+52)+" "+
            (baseline-85);


        /* S */

        path+=
            " L "+
            (base+62)+" "+
            (baseline+38);


        /* recovery */

        path+=
            " L "+
            (base+70)+" "+
            (baseline-2);


        /* T wave */

        path+=
            " C "+
            (base+82)+" "+
            (baseline-20)+
            ", "+
            (base+95)+" "+
            (baseline-20)+
            ", "+
            (base+108)+" "+
            baseline;


        path+=
            " L "+
            (base+cycle)+" "+
            baseline;

    }

    return path;
}


