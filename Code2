            selectedTime.split(":");

        hours=
            Number(parts[0]);

        minutes=
            Number(parts[1]);

        seconds=0;

    }else{

        const now=
            new Date();

        hours=
            now.getHours();

        minutes=
            now.getMinutes();

        seconds=
            now.getSeconds();

    }

    document
    .getElementById("time")
    .innerText=

        String(hours).padStart(2,"0")
        +":"
        +
        String(minutes).padStart(2,"0")
        +":"
        +
        String(seconds).padStart(2,"0");

    updateShift(
        hours,
        minutes
    );
}

