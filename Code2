<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Energy Monitoring System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:"Times New Roman",serif;
    background:#f5f9fc;
    color:#123b63;
}

/* ================= HEADER ================= */

.header{
    height:75px;
    background:#123b63;
    color:white;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:10px 25px;
    position:relative;
}

.left-panel{
    background:#315f82;
    padding:7px 10px;
    border-radius:7px;
    display:flex;
    align-items:center;
    box-shadow:0 2px 6px rgba(0,0,0,.15);
}

.left-details{
    display:flex;
    align-items:center;
    gap:8px;
}

/* ================= TIME ================= */

.time-box{
    position:relative;
    background:white;
    color:#222;
    border-radius:5px;
    height:35px;
    padding:5px 10px;
    display:flex;
    align-items:center;
    gap:6px;
    font-size:14px;
    cursor:pointer;
}

.timer-logo{
    font-size:17px;
}

#timePicker{
    position:absolute;
    opacity:0;
    width:35px;
    height:30px;
    left:7px;
    cursor:pointer;
}

/* ================= DATE ================= */

.date-box{
    position:relative;
    background:white;
    color:#222;
    border-radius:5px;
    height:35px;
    min-width:145px;
    padding:5px 10px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:3px;
    font-size:14px;
    cursor:pointer;
}

.calendar-logo{
    font-size:17px;
    margin-right:3px;
}

#datePicker{
    position:absolute;
    opacity:0;
    width:35px;
    height:30px;
    left:7px;
    cursor:pointer;
}

/* ================= SHIFT ================= */

.shift-box{
    min-width:75px;
    height:35px;
    padding:5px 10px;
    background:white;
    color:#222;
    border-radius:5px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:14px;
    font-weight:bold;
}

/* ================= HEADING ================= */

.heading{
    position:absolute;
    left:50%;
    transform:translateX(-50%);
    white-space:nowrap;
}

.heading h1{
    font-size:27px;
    letter-spacing:1px;
    display:flex;
    align-items:center;
    gap:12px;
}

/* ================= LIVE ================= */

.live-logo{
    display:inline-flex;
    align-items:center;
    gap:5px;
    padding:4px 9px;
    background:#1f9d55;
    color:white;
    border-radius:13px;
    font-size:11px;
    font-weight:bold;
    animation:liveGlow 1.5s infinite;
}

.live-dot{
    width:7px;
    height:7px;
    background:white;
    border-radius:50%;
    animation:liveBlink 1s infinite;
}

@keyframes liveBlink{
    0%,100%{
        opacity:1;
        transform:scale(1);
    }
    50%{
        opacity:.3;
        transform:scale(.7);
    }
}

@keyframes liveGlow{
    0%,100%{
        box-shadow:0 0 3px rgba(255,255,255,.2);
    }
    50%{
        box-shadow:0 0 10px rgba(255,255,255,.55);
    }
}

/* ================= RIGHT ================= */

.right-icons{
    display:flex;
    align-items:center;
    gap:20px;
}

.icon{
    font-size:15px;
    cursor:pointer;
}

.icon:hover{
    opacity:.75;
}

/* ================= MAIN MENU ================= */

.menu{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:8px;
    padding:12px 18px;
    background:#d0e0ed;
    border-radius:8px;
    margin:8px 35px 0;
    box-shadow:0 3px 8px rgba(18,59,99,.15);
    white-space:nowrap;
}

.box{
    padding:12px 14px;
    background:#dceaf5;
    border:1px solid #a9c5da;
    border-radius:5px;
    font-size:13px;
    color:#123b63;
    font-weight:bold;
    text-align:center;
    cursor:pointer;
    box-shadow:0 2px 5px rgba(18,59,99,.15);
    transition:.3s;
}

.box:hover{
    background:#c0d7e8;
    transform:translateY(-2px);
}

/* ACTIVE DARK */

.box.active{
    background:#123b63;
    color:white;
    border-color:#123b63;
}

/* ================= SUBTOPICS ================= */

.subtopic-container{
    display:none;
    justify-content:center;
    align-items:center;
    gap:6px;
    padding:8px 15px;
    margin:6px 35px 0;
    background:#e3edf5;
    border-radius:7px;
    box-shadow:0 2px 6px rgba(18,59,99,.12);
    white-space:nowrap;
}

.subtopic-container.show{
    display:flex;
}

.subtopic{
    background:white;
    color:#123b63;
    border:1px solid #9dbbd1;
    border-radius:4px;
    padding:7px 12px;
    font-size:12px;
    font-weight:bold;
    min-width:88px;
    text-align:center;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    transition:.25s;
}

.subtopic:hover{
    background:#315f82;
    color:white;
}

.subtopic.active-subtopic{
    background:#123b63;
    color:white;
}

/* ================= LIVE DOT ================= */

.sub-live-dot{
    width:7px;
    height:7px;
    background:#20c76a;
    border-radius:50%;
    display:inline-block;
    box-shadow:0 0 5px #20c76a;
    animation:subLiveBlink 1s infinite;
}

@keyframes subLiveBlink{
    0%,100%{
        opacity:1;
        transform:scale(1);
    }
    50%{
        opacity:.35;
        transform:scale(.7);
    }
}

/* ================= GAUGE ================= */

.dashboard{
    display:none;
    margin:15px 35px;
    padding:15px;
    background:white;
    border-radius:10px;
    box-shadow:0 3px 12px rgba(18,59,99,.15);
}

.dashboard.show{
    display:block;
}

.dashboard-title{
    text-align:center;
    font-size:21px;
    font-weight:bold;
    margin-bottom:15px;
}

.gauge-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
}

.gauge-card{
    background:#f8fbfd;
    border:1px solid #d0e0ed;
    border-radius:10px;
    padding:10px;
    text-align:center;
    box-shadow:0 2px 6px rgba(18,59,99,.10);
}

.gauge-title{
    font-size:15px;
    font-weight:bold;
}

.gauge{
    width:220px;
    height:145px;
    margin:auto;
    position:relative;
}

.gauge svg{
    width:220px;
    height:145px;
}

.gauge-bg{
    fill:none;
    stroke:#dce6ed;
    stroke-width:18;
    stroke-linecap:round;
}

.gauge-value{
    fill:none;
    stroke-width:18;
    stroke-linecap:round;
    stroke-dasharray:0 235;
    transition:stroke-dasharray .7s ease;
}

.power-color{
    stroke:#e74c3c;
}

.apparent-color{
    stroke:#3498db;
}

.energy-color{
    stroke:#27ae60;
}

.apparent-energy-color{
    stroke:#9b59b6;
}

.frequency-color{
    stroke:#f39c12;
}

.pf-color{
    stroke:#16a085;
}

.gauge-number{
    position:absolute;
    left:0;
    right:0;
    bottom:20px;
    text-align:center;
    font-size:23px;
    font-weight:bold;
}

.gauge-unit{
    font-size:12px;
    font-weight:bold;
    color:#607d8b;
}

/* ==================================================
   POWER CONSUMPTION TREND
================================================== */

.trend-section{
    display:none;
    margin:15px 35px;
    background:white;
    border-radius:10px;
    padding:15px;
    box-shadow:0 3px 12px rgba(18,59,99,.15);
}

.trend-section.show{
    display:block;
}

.trend-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:12px;
}

.trend-title{
    font-size:20px;
    font-weight:bold;
}

/* ================= DROPDOWN ================= */

.all-container{
    position:relative;
}

.all-button{
    background:#123b63;
    color:white;
    border:1px solid #123b63;
    border-radius:5px;
    padding:8px 18px;
    min-width:100px;
    font-family:"Times New Roman",serif;
    font-size:13px;
    font-weight:bold;
    cursor:pointer;
}

.all-button:hover{
    background:#315f82;
}

.dropdown-menu{
    display:none;
    position:absolute;
    right:0;
    top:43px;
    width:160px;
    background:white;
    border:1px solid #a9c5da;
    border-radius:6px;
    overflow:hidden;
    box-shadow:0 4px 10px rgba(18,59,99,.2);
    z-index:100;
}

.dropdown-menu.show{
    display:block;
}

.dropdown-item{
    padding:9px 12px;
    font-size:13px;
    color:#123b63;
    cursor:pointer;
    border-bottom:1px solid #edf3f7;
}

.dropdown-item:last-child{
    border-bottom:none;
}

.dropdown-item:hover{
    background:#dceaf5;
}

.dropdown-item.selected{
    background:#123b63;
    color:white;
}

/* ==================================================
   HEARTBEAT WAVE CHART
================================================== */

.chart-wrapper{
    width:100%;
    height:430px;
    position:relative;
    border:1px solid #d5e2eb;
    border-radius:8px;
    background:#fbfdff;
    overflow:hidden;
}

.chart-area{
    position:absolute;
    left:75px;
    right:25px;
    top:25px;
    bottom:60px;
}

/* GRID */

.grid-line{
    position:absolute;
    left:0;
    right:0;
    height:1px;
    background:#dce6ed;
}

.grid-1{top:0;}
.grid-2{top:20%;}
.grid-3{top:40%;}
.grid-4{top:60%;}
.grid-5{top:80%;}
.grid-6{top:100%;}

/* SVG */

#trendChart{
    width:100%;
    height:100%;
    overflow:visible;
}

/* HEARTBEAT WAVE */

#heartbeatLine{
    fill:none;
    stroke:#e74c3c;
    stroke-width:3;
    stroke-linecap:round;
    stroke-linejoin:round;
}

/* moving glow */

#heartbeatGlow{
    fill:none;
    stroke:#e74c3c;
    stroke-width:7;
    opacity:.12;
    stroke-linecap:round;
    stroke-linejoin:round;
}

/* ================= AXIS ================= */

.y-axis-title{
    position:absolute;
    left:13px;
    top:50%;
    transform:rotate(-90deg) translateX(-50%);
    transform-origin:left top;
    font-size:14px;
    font-weight:bold;
}

.x-axis-title{
    position:absolute;
    bottom:12px;
    left:50%;
    transform:translateX(-50%);
    font-size:14px;
    font-weight:bold;
}

/* Y LABELS */

.y-label{
    position:absolute;
    left:32px;
    font-size:11px;
    color:#607d8b;
}

.y100{top:21px;}
.y80{top:101px;}
.y60{top:181px;}
.y40{top:261px;}
.y20{top:341px;}

/* TIME */

.time-labels{
    position:absolute;
    left:75px;
    right:25px;
    bottom:35px;
    display:flex;
    justify-content:space-between;
    font-size:11px;
    color:#607d8b;
}

/* CURRENT */

.current-value{
    position:absolute;
    right:28px;
    top:12px;
    padding:6px 12px;
    border-radius:5px;
    background:#123b63;
    color:white;
    font-size:13px;
    font-weight:bold;
    z-index:10;
}

/* ================= RESPONSIVE ================= */

@media(max-width:1000px){

    .heading h1{
        font-size:22px;
    }

    .menu{
        overflow-x:auto;
        justify-content:flex-start;
    }

    .subtopic-container{
        overflow-x:auto;
        justify-content:flex-start;
    }

    .gauge-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:600px){

    .gauge-grid{
        grid-template-columns:1fr;
    }

    .trend-header{
        align-items:flex-start;
        gap:10px;
    }
}
</style>
</head>

